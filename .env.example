# Anthropic API Key (required)
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Database (SQLite for local development, PostgreSQL for production)
DATABASE_URL="file:./prisma/dev.db"
# For production (Neon/PostgreSQL):
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth.js (required for auth — generate with: openssl rand -base64 32)
AUTH_SECRET=your-secret-key-change-me-in-production

# App URL (used by NextAuth for redirects)
AUTH_URL=http://localhost:3000

# --- Optional Services (uncomment when ready) ---

# Upstash Redis (rate limiting — free tier at https://upstash.com)
# UPSTASH_REDIS_URL=https://xxx.upstash.io
# UPSTASH_REDIS_TOKEN=your-token

# Resend (email verification and password reset — free tier at https://resend.com)
# RESEND_API_KEY=re_xxx
